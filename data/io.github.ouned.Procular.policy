<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Procular</vendor>
  <action id="io.github.ouned.Procular.helper">
    <description>Manage processes of other users</description>
    <message>Authentication is required to manage or inspect processes of other users</message>
    <icon_name>io.github.ouned.Procular</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/procular-helper</annotate>
  </action>
</policyconfig>
